{
  "manifest_version": 3,
  "name": "Voxly — AI Text Rewriter",
  "version": "1.0.0",
  "description": "Rewrite any text while preserving your unique voice. Select text, right-click, choose a tone, done.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "cookies",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://voxly.app/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voxly"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "rewrite-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Rewrite selected text with Voxly"
    }
  }
}
